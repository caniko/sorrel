    given-names: Can H.
version: 0.4.0
date-released: "2026-11-03"
license:
  - MIT
  - Apache-2.0
repository-code: "https://github.com/caniko/sorrel"
url: "https://sorrel.tartanoglu.com/"
keywords:
  - electrophysiology
  - spike sorting
  - manual curation
  - phy
  - Kilosort
  - SpikeInterface
  - neuroscience
  - Rust
