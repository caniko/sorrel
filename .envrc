strict_env
nix_direnv_disallow_fallback
use flake .
watch_file ../nix-opencode-lsp/lib/default.nix
if [[ -f ../nix-opencode-lsp/flake.nix ]]; then
  use flake 'git+https://github.com/caniko/harbor.git?ref=feat/harbor-monorepo-components&rev=e8b1996580e4ecd51dd402edf4a16d9df88e3a1b#rust-opencode-lsp' --override-input nix-opencode-lsp path:../nix-opencode-lsp
else
  use flake 'git+https://github.com/caniko/harbor.git?ref=feat/harbor-monorepo-components&rev=e8b1996580e4ecd51dd402edf4a16d9df88e3a1b#rust-opencode-lsp'
fi
